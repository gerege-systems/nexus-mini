# nexus-mini тохиргоо — энэ файлыг nexus-mini.env нэрээр хуулж бөглөнө:
#   cp .env.example backend/nexus-mini.env
# DB role + сангаа урьдчилан үүсгэнэ: psql -f deploy/01-roles.sql (доорх нүүрийг хар)

# nexus_app — аппын бүх tenant урсгал (RLS үйлчилнэ)
DATABASE_URL=postgres://nexus_app:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini
# nexus_admin — платформын админ панель (nexus_platform гишүүн)
DATABASE_URL_ADMIN=postgres://nexus_admin:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini
# nexus_auth — зөвхөн нэвтрэлтийн definer функцууд (session, signup, handover)
DATABASE_URL_AUTH=postgres://nexus_auth:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini
# nexus_owner — зөвхөн миграц
DATABASE_URL_OWNER=postgres://nexus_owner:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini

# Анхны платформын админ — `make migrate` ажиллахад админ огт
# байхгүй бол эндхээс үүсгэнэ (байгаа бол дахин хүрэхгүй).
ADMIN_EMAIL=tanii@mail.mn
ADMIN_NAME=Таны нэр
ADMIN_PASSWORD=нууц-үгээ-соль

PORT=8084
# Portal-ийн гадаад URL — админ панелээс impersonation handover холбоос үүсгэхэд
PORTAL_URL=http://localhost:3020
ENVIRONMENT=development
# App store registry — гарын үсэгтэй index.json. Default: gerege-systems/nexus-registry (GitHub raw)
# (gerege-systems/nexus-registry, түлхүүр цөмд суусан). Өөрийн registry бол
# REGISTRY_URL + REGISTRY_KEYS (base64 нийтийн түлхүүр, таслалаар). "off" = зөвхөн файл.
# REGISTRY_URL=https://raw.githubusercontent.com/gerege-systems/nexus-registry/main/index.json
# REGISTRY_KEYS=
# REGISTRY_CACHE_DIR=.registry-cache   (systemd: /var/cache/nexus-mini — unit-ийн CacheDirectory)
# SSO-оор нэвтрэх (relying party) — заавал биш. Google: console.cloud.google.com
# (redirect: <PORTAL_URL>/api/auth/sso/google/callback). Ерөнхий OIDC (өөр
# nexus-mini ч байж болно): SSO_ISSUER=https://nexus.bold.mn/api/oauth2
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SSO_ISSUER=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_NAME=Bold SSO
# SSO_AUTO_SIGNUP=false      # true бол танигдаагүй имэйлд данс үүсгэнэ (JIT)
# SSO_TRUST_EMAIL=false      # true бол issuer-ийн имэйлд email_verified-гүй ч итгэнэ (nexus-mini federation)
# Локал fallback index (registry хүрэхгүй үед)
CATALOG_PATH=../catalog/index.json
