# nexus-mini тохиргоо — энэ файлыг nexus-mini.env нэрээр хуулж бөглөнө:
#   cp .env.example backend/nexus-mini.env
# DB role + сангаа урьдчилан үүсгэнэ: psql -f deploy/01-roles.sql (доорх нүүрийг хар)

# nexus_app — аппын бүх tenant урсгал (RLS үйлчилнэ)
DATABASE_URL=postgres://nexus_app:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini
# nexus_admin — платформын админ панель (nexus_platform гишүүн)
DATABASE_URL_ADMIN=postgres://nexus_admin:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini
# nexus_auth — зөвхөн нэвтрэлтийн definer функцууд (session, signup, handover)
DATABASE_URL_AUTH=postgres://nexus_auth:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini
# nexus_owner — зөвхөн миграц
DATABASE_URL_OWNER=postgres://nexus_owner:НУУЦ_ҮГ@127.0.0.1:5432/nexus_mini

# Анхны платформын админ — `make migrate` ажиллахад админ огт
# байхгүй бол эндхээс үүсгэнэ (байгаа бол дахин хүрэхгүй).
ADMIN_EMAIL=tanii@mail.mn
ADMIN_NAME=Таны нэр
ADMIN_PASSWORD=нууц-үгээ-соль

PORT=8084
# Portal-ийн гадаад URL — админ панелээс impersonation handover холбоос үүсгэхэд
PORTAL_URL=http://localhost:3020
ENVIRONMENT=development
CATALOG_PATH=../catalog/apps.json
