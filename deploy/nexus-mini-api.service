[Unit]
Description=nexus-mini API
After=network.target postgresql.service

[Service]
User=bay
WorkingDirectory=/srv/nexus-mini
EnvironmentFile=/home/bay/secrets/nexus-mini.env
ExecStart=/srv/nexus-mini/backend/bin/nexus-mini serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/tmp
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
