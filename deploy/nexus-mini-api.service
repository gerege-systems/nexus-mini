[Unit]
Description=nexus-mini API
After=network.target postgresql.service

[Service]
# Үйлчилгээний хэрэглэгч: өөрийн орчиндоо тааруулна. Энэ файлыг засахын оронд
# drop-in ашигла: /etc/systemd/system/<unit>.d/override.conf → [Service] User=<өөрийн>
User=nexus
WorkingDirectory=/srv/nexus-mini
EnvironmentFile=/etc/nexus-mini/nexus-mini.env
ExecStart=/srv/nexus-mini/backend/bin/nexus-mini serve
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
# Registry index кэш (ProtectSystem=strict тул /srv бичигдэхгүй) → /var/cache/nexus-mini
CacheDirectory=nexus-mini
ReadWritePaths=/tmp
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
