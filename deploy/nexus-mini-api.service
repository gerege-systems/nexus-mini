[Unit]
Description=nexus-mini API
After=network.target postgresql.service

[Service]
User=bay
WorkingDirectory=/srv/nexus-mini
EnvironmentFile=/home/bay/secrets/nexus-mini.env
ExecStart=/srv/nexus-mini/backend/bin/nexus-mini serve
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
# Registry index кэш (ProtectSystem=strict тул /srv бичигдэхгүй) → /var/cache/nexus-mini
CacheDirectory=nexus-mini
ReadWritePaths=/tmp
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
