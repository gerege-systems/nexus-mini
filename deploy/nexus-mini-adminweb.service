[Unit]
Description=nexus-mini Admin Web (Next.js)
After=network.target nexus-mini-api.service

[Service]
User=bay
WorkingDirectory=/srv/nexus-mini/admin
Environment=NODE_ENV=production
Environment=API_URL=http://127.0.0.1:8084
ExecStart=/srv/nexus-mini/admin/node_modules/.bin/next start -p 3021
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/nexus-mini/admin/.next
PrivateTmp=true

[Install]
WantedBy=multi-user.target
